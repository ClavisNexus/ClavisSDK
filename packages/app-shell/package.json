{
  "name": "@clavis.nexus/app-shell",
  "version": "2.1.0",
  "description": "Browser parts for Clavis App: the overlay that hands over to Connect, and the Sign in with Clavis button",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ClavisNexus/ClavisSDK.git",
    "directory": "packages/app-shell"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./button.css": "./dist/button.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "OFL.txt",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && cp src/styles.css src/button.css src/clavis-button-grotesk.woff2 dist/",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "jsdom": "^31.0.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}

{
  "name": "@clavis.nexus/app",
  "version": "3.1.1",
  "description": "Server SDK for Clavis App — sign users in with Clavis and link their accounts, check agreements before an action, register signature requests and delegations, verify receipts and records with the Collatio verifier, and commit ledger records with an opening the holder can keep",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ClavisNexus/ClavisSDK.git",
    "directory": "packages/app"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@clavis.nexus/collatio": "1.0.3",
    "jose": "6.2.16"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
